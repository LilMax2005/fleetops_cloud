<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.fleetops</groupId>
  <artifactId>fleetops-ep5</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>FleetOps EP5 (Kafka + administracion)</name>
  <description>Modulos EP5 sobre Spring Boot 3.5: libreria comun, servicio-monitoreo (consumidor Kafka), admin-kafka y admin-rabbitmq. Los servicios originales (servicio-flota, ms-alerta, simulator, mcp) siguen siendo proyectos independientes.</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <modules>
    <module>fleetops-common</module>
    <module>servicio-monitoreo</module>
    <module>admin-rabbitmq</module>
    <module>admin-kafka</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fleetops</groupId>
        <artifactId>fleetops-common</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
